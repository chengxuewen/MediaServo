# MediaServo host configuration (generated by `host init`)
# Docs: docs/modules/03-client-host.md · history: CHANGELOG.md
host:
  device_id: ""              # empty = auto-filled by init from identity.json

# -- Signaling (example - typically injected by env/CLI at start) --------------
# signaling:
#   server_url: "ws://192.168.2.127:9800/ws"   # MediaServo server address
#   psk: "mediaservo-dev"                      # must match the server's psk
#   room: "my-car1"   # vehicle room. Default: hostname baked at init (fleet-safe);
#                     # unset falls back to the system hostname, then "vehicle".
#   local_port: 17980                          # local gateway port

# -- defaults: shared values for sources/streams -------------------------------
# Merge per key: entry > defaults.<subsection> > built-in default.
# Strict keys: a typo here errors at init/start/apply (never silently ignored).
defaults:
  streams:
    codec: h264            # h264 | vp8 | vp9 | av1 - detail at streams below
    stream_mode: smooth    # smooth | balanced | quality - see streams below
    keyframe_interval: 2   # GOP seconds
  sources:
  # Platform/tuning keys only (backend/width/height/fps/reconnect_ms).
  # mode/input are per-source identity - sharing them here is rejected.
    fps: 30

# -- sources: video capture declarations ---------------------------------------
# mode: generator (test color bars) | camera (v4l2) | desktop* | subscriber*
#       (* planned - capturer exits with an explicit "unsupported" error)
# Keys: input (device path / topic) | width/height (default 1280x720) |
#       fps (default 30, <=60) | reconnect_ms (camera only) | backend (declarative)
sources:
  - id: "cam0"
    mode: "camera"
    backend: "v4l2"
    input: "/dev/video0"
    width: 1920
    height: 1080
    fps: 30
    reconnect_ms: 5000
  - id: "test"             # minimal shape - remaining keys inherit defaults

# -- streams: publish declarations (streams[].source references sources[].id) --
# codec (default h264):
#   h264  OpenH264 software - product default, browser/vehicle universal
#   vp8   libwebrtc software - max compatibility
#   vp9   software - best compression, heavy CPU
#   av1   SVT-AV1 - very heavy CPU, avoid for live push
#   NOTE: without an explicit codec, an upgrade switches vp8 -> h264.
#         Write codec: vp8 to keep the old behavior.
# encoder_backend (default auto):
#   auto      h264 pins to software; others pick at runtime
#   software  force software | hardware  force hw | nvenc / vaapi  GPU
# bitrate_kbps       default 2000 (1080p: 2500-4000, 720p: 1500-2500)
# stream_mode (default balanced):
#   smooth    hold framerate, drop resolution; bitrate floor from fps:
#             max(50, fps*100/30) kbps - recommended for teleoperation
#   balanced  degrade both (default)
#   quality   hold resolution, drop framerate + 3000 kbps ceiling - forensics
#   Explicit bitrate_kbps/min_bitrate_kbps always win over the preset
#   (keep min_bitrate_kbps <= bitrate_kbps/4).
# keyframe_interval  default 2s; smaller = faster loss recovery
streams:
  - id: "cam0-stream"
    source: "cam0"         # encode/policy keys inherit defaults

record:
  enabled: false           # false = no recorder process; omit = legacy park mode

control:
  enabled: false
