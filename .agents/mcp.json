{
  "mcpServers": {
    "local-codegraph": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/agents/mcp-launch.sh", "local-codegraph"]
    },
    "local-playwright": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/agents/mcp-launch.sh", "local-playwright"]
    },
    "local-serena": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/agents/mcp-launch.sh", "local-serena"]
    },
    "websearch": {
      "type": "remote",
      "url": "https://websearch.opencode.ai",
      "enabled": false
    },
    "figma": {
      "type": "stdio",
      "command": "bash",
      "args": ["scripts/agents/mcp-launch.sh", "figma"]
    }
  }
}
