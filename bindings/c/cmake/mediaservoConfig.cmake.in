# mediaservoConfig.cmake — find_package(mediaservo [COMPONENTS field|link|deck])
# Single-package multi-component mode (OpenCV/Boost convention): all three INTERFACE targets are defined (link granularity is
# decided by target_link_libraries), COMPONENTS is a declarative check (missing/unknown components error out).
# Hand-maintained template (equivalent to the iceoryx2 Config.cmake.in output discipline, D248): renders @VERSION@/@MAJOR@ at install time
# Relocatable: the prefix is derived from this file's location (lib/cmake/mediaservo → ../../..)

get_filename_component(_mediaservo_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

if(WIN32)
    set(_mediaservo_lib_ext "dll")
    set(_mediaservo_lib_prefix "")
elseif(APPLE)
    set(_mediaservo_lib_ext "dylib")
    set(_mediaservo_lib_prefix "lib")
else()
    set(_mediaservo_lib_ext "so")
    set(_mediaservo_lib_prefix "lib")
endif()

set(mediaservo_INSTALLED_SDK @SDK_LIST@)
set(mediaservo_KNOWN_COMPONENTS ${mediaservo_INSTALLED_SDK})
foreach(_sdk IN LISTS mediaservo_INSTALLED_SDK)
    if(NOT TARGET mediaservo::${_sdk})
        add_library(mediaservo::${_sdk} INTERFACE IMPORTED)
        set_target_properties(mediaservo::${_sdk} PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${_mediaservo_prefix}/include"
            INTERFACE_LINK_LIBRARIES "${_mediaservo_prefix}/lib/${_mediaservo_lib_prefix}mediaservo_${_sdk}.${_mediaservo_lib_ext}"
        )
    endif()
endforeach()

set(mediaservo_FOUND TRUE)
set(mediaservo_VERSION "@VERSION@")
set(mediaservo_SDK_ABI_MAJOR "@MAJOR@")
set(mediaservo_INCLUDE_DIRS "${_mediaservo_prefix}/include")

# -- COMPONENTS declarative check (OpenCV/Boost pattern) ------------------------
# Hand-written check (the FPHSA CONFIG_MODE+HANDLE_COMPONENTS combination is behaviorally unstable);
# the version check is handled by CMake auto-including mediaservoConfigVersion.cmake from this directory.
foreach(_comp IN LISTS mediaservo_FIND_COMPONENTS)
    if(NOT _comp IN_LIST mediaservo_KNOWN_COMPONENTS)
        message(FATAL_ERROR
            "mediaservo: unknown component '${_comp}' (known: ${mediaservo_KNOWN_COMPONENTS})")
    endif()
endforeach()
