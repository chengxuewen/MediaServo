{
  "schema": "weaknet-golden/1",
  "note": "the 9 inherited cases are transcribed verbatim from scripts/weaknet.sh self_check (dir=both baseline, imported 2026-09-08, the bash source no longer traced); the 3 dir cases = the new contract (derived from the design §dir leg-definition table, human-reviewed, no bash ancestor). Rendering/assembly contract implementations in T2 spec.rs.",
  "cases": [
    {
      "id": "delay-half", "source": "bash", "kind": "netem_spec",
      "input": { "rtt_ms": 80, "jitter_ms": 15, "loss": "0%", "loss_mode": "simple" },
      "expect": "limit 100000 delay 40ms 7ms distribution normal"
    },
    {
      "id": "loss-append", "source": "bash", "kind": "netem_spec",
      "input": { "rtt_ms": 80, "jitter_ms": 15, "loss": "2%", "loss_mode": "simple" },
      "expect": "limit 100000 delay 40ms 7ms distribution normal loss 2%"
    },
    {
      "id": "gemodel", "source": "bash", "kind": "netem_spec",
      "input": { "rtt_ms": 120, "jitter_ms": 0, "loss": "10%", "loss_mode": "gemodel", "gemodel": ["0.1", "0.02", "0.001"] },
      "expect": "limit 100000 delay 60ms loss gemodel 10 0.1 0.02 0.001"
    },
    {
      "id": "gemodel-loss0-demote", "source": "bash", "kind": "netem_spec",
      "input": { "rtt_ms": 0, "jitter_ms": 0, "loss": "0%", "loss_mode": "gemodel", "gemodel": ["0.1", "0.02", "0.001"] },
      "expect": "limit 100000 loss 0%",
      "note": "with loss=0 gemodel downgrades to simple rendering and the zero delay segment is omitted entirely"
    },
    {
      "id": "gemodel-pct-strip", "source": "bash", "kind": "netem_spec",
      "input": { "rtt_ms": 120, "jitter_ms": 0, "loss": "8%", "loss_mode": "gemodel", "gemodel": ["25%", "0.2", "0.05"] },
      "expect": "limit 100000 delay 60ms loss gemodel 8 25 0.2 0.05",
      "note": "GEMODEL_R with % input -> stripped"
    },
    {
      "id": "frac-loss", "source": "bash", "kind": "netem_spec",
      "input": { "rtt_ms": 0, "jitter_ms": 0, "loss": "0.5%", "loss_mode": "simple" },
      "expect": "limit 100000 loss 0.5%"
    },
    {
      "id": "reorder", "source": "bash", "kind": "netem_spec",
      "input": { "rtt_ms": 0, "jitter_ms": 0, "loss": "0%", "loss_mode": "simple", "reorder": "5" },
      "expect": "limit 100000 reorder 5%"
    },
    {
      "id": "rate-sentinel", "source": "bash", "kind": "rate_arg",
      "input": { "rate_mbps": null },
      "expect": "1000gbit",
      "note": "htb sentinel when rate unset (no limit = astronomic bandwidth)"
    },
    {
      "id": "rate-set", "source": "bash", "kind": "rate_arg",
      "input": { "rate_mbps": 4 },
      "expect": "4mbit"
    },
    {
      "id": "legs-media-out-lo", "source": "new-contract", "kind": "legs",
      "input": { "scope": "media", "dir": "out", "iface": "lo", "local_ports": [40010, 40011] },
      "expect": {
        "filters": [
          { "protocol": 17, "matches": [["sport", 40010]], "flowid": "1:10" },
          { "protocol": 17, "matches": [["sport", 40011]], "flowid": "1:10" }
        ]
      },
      "note": "Media section dir=out = server->client (sending) -> sport over the local media ports; one filter per port; protocol 17 is the rev-2.1 conjunction"
    },
    {
      "id": "legs-media-in-lo", "source": "new-contract", "kind": "legs",
      "input": { "scope": "media", "dir": "in", "iface": "lo", "local_ports": [40010] },
      "expect": {
        "filters": [
          { "protocol": 17, "matches": [["dport", 40010]], "flowid": "1:10" }
        ]
      },
      "note": "Media section dir=in = client->server (receiving) -> dport over the local media ports; a physical iface in this direction moves to the ifb mirror (§ifb contract), lo keeps the port leg"
    },
    {
      "id": "legs-stream-both-lo", "source": "new-contract", "kind": "legs",
      "input": { "scope": "stream", "dir": "both", "iface": "lo", "pairs": [{ "local": 40010, "remote": 51234 }] },
      "expect": {
        "filters": [
          { "protocol": 17, "matches": [["sport", 40010], ["dport", 51234]], "flowid": "1:10" },
          { "protocol": 17, "matches": [["sport", 51234], ["dport", 40010]], "flowid": "1:10" }
        ]
      },
      "note": "Stream level = ordered pair (L,R) both legs, one filter per direction with a dual-match AND conjunction; out=(sport=L AND dport=R) in=(sport=R AND dport=L). Splitting into two single-match filters = OR and would cross-hit (Momus/kernel-F9); implementation and tests both pin this structure"
    }
  ]
}
