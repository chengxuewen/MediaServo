prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: mediaservo-client
Description: MediaServo client C ABI — cockpit/consumer-side SDK (login + SFU consumption + control DC)
Version: @VERSION@
Libs: -L${libdir} -lmediaservo_client
Cflags: -I${includedir}
