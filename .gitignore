# This file is used to ignore files which are generated
# ----------------------------------------------------------------------------

*~
*.autosave
*.core
.#*
*.*#
tags
.directory
*.debug
*.app
Thumbs.db

# xemacs temporary files
*.flc

# Vim temporary files
.*.swp

# Visual Studio generated files
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*

# MinGW generated files
*.Debug
*.Release

# Python byte code
*.pyc

# Binaries
# --------
*.dll
*.exe

# IDE files
# --------
.vs
.cache
.vscode/*
# whitelist: the IDE settings template is tracked (polyorch-adoption CA-1);
# negations of exact files WORK under a `.vscode/*` rule (only contents are
# ignored, so git still descends) -- a bare `.vscode` dir rule would be inert.
!.vscode/settings.example.json
!.vscode/settings.json

# Build dirs
# --------
/out
/log
/dist
/build
/target
/logs
*.node
/install

# Temp dirs
# --------
/nodejs
/stash

# www build outputs (pnpm build artifacts; the inner www/.gitignore also guards)
www/apps/*/dist/

# nodejs environments
node_modules
.npm-cache
.turbo

# agent toolchain local echoes (pins live in scripts/agents/mcp-servers.json)
scripts/agents/package.json
scripts/agents/package-lock.json
__pycache__/

# Don't ignore files
# --------

# Agent dirs
.venv-openspace
.playwright-mcp
# pixi environment manager
.pixi
.pixi-pack
.pixi-cache
.sisyphus/
.omo/*

# Official reference source clones (git-ignored, script-managed)
.refinfo

# Test and build artifacts
test-results
*.tsbuildinfo

# Python bindings example artifacts
/bindings/python/mediaservo/mediaservo/_libs/
/bindings/python/mediaservo/mediaservo.egg-info/

# host multi-process runtime artifacts (host init/start at repo root)
.host/
/etc/
/run/
/recordings/
/identity.json
/data/

# imgui 布局缓存（09-24 脱轨：曾被子仓根跟踪=CI/构建目录污染面）
imgui.ini
*.imgui.ini
imgui_viewer.ini

# --- Transient artifacts (2026-10-30 audit) ---
# Root-level logs only: tests/goldens/**/*.jsonl and docs evidence stay tracked.
/*.log
/*.jsonl
*.tmp
*.bak
*.orig
*.rej
*.swp
*.swo
*.pid
*.sock
*.stackdump
core.[0-9]*
*.dSYM/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
coverage.xml
tarpaulin-report.html
*.profraw
.DS_Store
.idea/
CMakeUserPresets.json
compile_commands.json
.env
.env.*
!.env.example
# Re-assert the tracked OMO config (the .omo/* rule above runs later than the first negation).
!.omo/omo.jsonc

# Code intelligence caches
.codegraph/
.serena/

# imgui runtime layout residue (example runs at the repo root, r2-L6)
/imgui.ini
/imgui_viewer.ini
