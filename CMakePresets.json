{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "default - acceptance, all off",
      "binaryDir": "${sourceDir}/build/presets/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MEDIASERVO_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "bindings",
      "displayName": "bindings - sdk lanes + renderers",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/presets/${presetName}",
      "cacheVariables": {
        "MEDIASERVO_BUILD_BINDINGS": "ON"
      }
    },
    {
      "name": "host",
      "displayName": "host - vehicle lanes (shared cache)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/presets/${presetName}",
      "cacheVariables": {
        "MEDIASERVO_BUILD_BINDINGS": "ON",
        "MEDIASERVO_BUILD_CRATES_LANES": "ON",
        "MEDIASERVO_SHARE_CARGO_TARGET": "ON"
      }
    },
    {
      "name": "server",
      "displayName": "server - cloud + www lanes (shared cache)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/presets/${presetName}",
      "cacheVariables": {
        "MEDIASERVO_BUILD_WEB": "ON",
        "MEDIASERVO_BUILD_CRATES_LANES": "ON",
        "MEDIASERVO_SHARE_CARGO_TARGET": "ON"
      }
    },
    {
      "name": "all",
      "displayName": "all - full lanes surface",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/presets/${presetName}",
      "cacheVariables": {
        "MEDIASERVO_BUILD_BINDINGS": "ON",
        "MEDIASERVO_BUILD_WEB": "ON",
        "MEDIASERVO_BUILD_CRATES_LANES": "ON",
        "MEDIASERVO_SHARE_CARGO_TARGET": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "bindings",
      "configurePreset": "bindings"
    },
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "server",
      "configurePreset": "server"
    },
    {
      "name": "all",
      "configurePreset": "all"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "all",
      "configurePreset": "all",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
