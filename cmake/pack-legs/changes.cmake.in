# changes.cmake.in — F11-X mechanical [scope] slicing of CHANGELOG.md (python
# _changelog_slice + _write_changes_file port; D280 single source stays untouched,
# routing happens only when packaging). Entry = "- " line + indented continuations;
# [scope] in the keep set survives; empty subsections/sections drop; file header
# always stays; a slice with zero items degrades to the raw full text (better too
# many than missing — new entries are marker-enforced by the CI gate instead).
# f8f85db rule: script-mode policy-neutral (list(FIND), never IN_LIST).
set(_src "@CHANGELOG@")
set(_outp "${CMAKE_INSTALL_PREFIX}/CHANGES.md")

if(NOT EXISTS "${_src}")
    message(WARNING "WARN: CHANGELOG.md missing — package ships without CHANGES.md (packaging not blocked)")
    return()
endif()

file(READ "${_src}" _text)
set(_keep "@KEEP@")            # space-separated scope vocabulary
string(REPLACE " " ";" _keepL "${_keep}")

# ---- line table (python splitlines; indexed scalars — semicolon lists would
# swallow blank lines and this slicer must not) ----
set(_N 0)
set(_rest "${_text}")
set(_scan TRUE)
while(_scan)
    string(FIND "${_rest}" "\n" _i)
    if(_i EQUAL -1)
        break()
    endif()
    string(SUBSTRING "${_rest}" 0 "${_i}" _line)
    set(_L${_N} "${_line}")
    math(EXPR _N "${_N} + 1")
    math(EXPR _next "${_i} + 1")
    string(SUBSTRING "${_rest}" "${_next}" -1 _rest)
endwhile()
if(NOT _rest STREQUAL "")
    set(_L${_N} "${_rest}")
    math(EXPR _N "${_N} + 1")
endif()

# ---- helpers (cmake functions see caller variables — dynamic scoping) ----
function(_msr_blank l out)
    if("${l}" MATCHES "^[ \t\r]*$")
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

# no marker = carry everything (pre-F11-X historical entries / upgrade-note prose);
# any marker in the keep set = carry (python _cl_keep)
function(_msr_cl_keep firstline out)
    string(FIND "${firstline}" ":" _c)
    if(_c EQUAL -1)
        set(_prefix "${firstline}")
    else()
        string(SUBSTRING "${firstline}" 0 "${_c}" _prefix)
    endif()
    string(REGEX MATCHALL "\\[([a-z0-9-]+)\\]" _tags "${_prefix}")
    if(NOT _tags)
        set(${out} TRUE PARENT_SCOPE)
        return()
    endif()
    foreach(_m IN LISTS _tags)
        string(REGEX REPLACE "^\\[(.*)\\]$" "\\1" _tg "${_m}")
        list(FIND _keepL "${_tg}" _ix)
        if(NOT _ix EQUAL -1)
            set(${out} TRUE PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${out} FALSE PARENT_SCOPE)
endfunction()

# render subsection [a,b): item blocks filtered, other lines pass through; zero kept
# "- " lines = the whole subsection vanishes with its non-item prose (python
# _cl_render_block). Outputs _msr_seg_text / _msr_seg_item (PARENT_SCOPE).
function(_msr_render_seg a b)
    set(_bo "")
    set(_boItem FALSE)
    set(_k "${a}")
    while(_k LESS b)
        set(_l "${_L${_k}}")
        if(_l MATCHES "^- ")
            set(_blk "${_l}\n")
            math(EXPR _k2 "${_k} + 1")
            while(_k2 LESS b)
                _msr_blank("${_L${_k2}}" _bl)
                if(_bl)
                    string(APPEND _blk "${_L${_k2}}\n")
                    math(EXPR _k2 "${_k2} + 1")
                    break()
                elseif("${_L${_k2}}" MATCHES "^[ \t]")
                    string(APPEND _blk "${_L${_k2}}\n")
                    math(EXPR _k2 "${_k2} + 1")
                else()
                    break()
                endif()
            endwhile()
            _msr_cl_keep("${_l}" _keepIt)
            if(_keepIt)
                string(APPEND _bo "${_blk}")
                set(_boItem TRUE)
            endif()
            set(_k "${_k2}")
            continue()
        endif()
        string(APPEND _bo "${_l}\n")
        math(EXPR _k "${_k} + 1")
    endwhile()
    set(_msr_seg_text "${_bo}" PARENT_SCOPE)
    set(_msr_seg_item "${_boItem}" PARENT_SCOPE)
endfunction()

# ---- slice: file head before the first "## " always stays ----
set(_headEnd ${_N})
set(_i 0)
while(_i LESS _N)
    if("${_L${_i}}" MATCHES "^## ")
        set(_headEnd ${_i})
        break()
    endif()
    math(EXPR _i "${_i} + 1")
endwhile()

set(_lines "")
set(_i 0)
while(_i LESS _headEnd)
    string(APPEND _lines "${_L${_i}}\n")
    math(EXPR _i "${_i} + 1")
endwhile()

set(_i "${_headEnd}")
while(_i LESS _N)
    if(NOT "${_L${_i}}" MATCHES "^## ")
        math(EXPR _i "${_i} + 1")
        continue()
    endif()
    set(_verHead "${_L${_i}}")
    math(EXPR _bs "${_i} + 1")
    set(_j "${_bs}")
    while(_j LESS _N)
        if("${_L${_j}}" MATCHES "^## ")
            break()
        endif()
        math(EXPR _j "${_j} + 1")
    endwhile()
    # ## body split by ### into blocks, rendered section by section
    set(_sectxt "")
    set(_segHead "")
    set(_segStart "${_bs}")
    set(_k "${_bs}")
    while(_k LESS _j)
        if("${_L${_k}}" MATCHES "^### ")
            _msr_render_seg("${_segStart}" "${_k}")
            if(_msr_seg_item)
                if(NOT _segHead STREQUAL "")
                    string(APPEND _sectxt "${_segHead}\n")
                endif()
                string(APPEND _sectxt "${_msr_seg_text}")
            endif()
            set(_segHead "${_L${_k}}")
            math(EXPR _segStart "${_k} + 1")
        endif()
        math(EXPR _k "${_k} + 1")
    endwhile()
    _msr_render_seg("${_segStart}" "${_j}")
    if(_msr_seg_item)
        if(NOT _segHead STREQUAL "")
            string(APPEND _sectxt "${_segHead}\n")
        endif()
        string(APPEND _sectxt "${_msr_seg_text}")
    endif()
    if(NOT _sectxt STREQUAL "")
        string(APPEND _lines "${_verHead}\n${_sectxt}")
    endif()
    set(_i "${_j}")
endwhile()

# ---- degrade rule (python _write_changes_file): a slice with zero "- " lines ships
# the raw full text unstripped; the slice path is join + rstrip + exactly one \n ----
if(_lines MATCHES "(^|\n)- ")
    string(REGEX REPLACE "[ \t\r\n]+$" "" _final "${_lines}")
    set(_final "${_final}\n")
else()
    set(_final "${_text}")
endif()
file(WRITE "${_outp}" "${_final}")
