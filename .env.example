# MediaServo msrtc production .env template (container-build-rework B3.4)
#
# Copy to .env and fill, then: docker compose --env-file .env up -d
# .env is gitignored (carries secrets); this template is tracked.
# The compose `${VAR:?}` floor fails fast on an empty required var (R6=B).

# --- contract: four required vars (all pass-through to the container) ---

# Image tag pin (rollback = re-pin the previous tag and `up -d` again).
TAG=0.1.3

# Site-reachable SFU announced IP. MULTI-NIC SITES MUST EXPLICIT-FILL the IP that
# clients reach (public/LAN). Auto-detect is dev-only: it concatenates all NIC
# IPs but the SFU takes the first only (sfu.rs:481-486) = silent ICE failure.
MEDIASERVO_SFU_ANNOUNCED_IP=

# First-boot admin password (init bootstrap account; persisted in the etc volume;
# rotate afterwards via the admin API). Required — empty fails fast.
MEDIASERVO_ADMIN_PASSWORD=

# Host ssh maintenance port (container 22 standard; host 2222 default avoids the
# CentOS-8 host-sshd conflict). Key-only auth; deliver authorized_keys into the
# etc volume (see the site runbook).
SSH_PORT=2222

# --- optional tuning (defaults shown; uncomment to override) ---

# Brand — defaults msrtc, matching the msrtc-branded image AND the interpolated
# volume paths (R15). Override only for a standalone mediaservo image+compose pair.
#MEDIASERVO_BRAND=msrtc

# Container memory limit (R13=C mem_limit only, CPU unset for RTP bursts).
# 2g PROVISIONAL — R18 Small-tier load test deferred (follow-up); idle baseline
# 28MiB peak. Final = measured peak x1.3 round-up-512MB (see 29-operations.md).
#MEM_LIMIT=2g