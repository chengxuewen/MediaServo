version: 1
listen:
  host: "0.0.0.0"
  port: 9800
room_capacity: 50
rate_limit: 100
consumer_limit_per_stream: 50
# 首启由 entrypoint 生成（__JWT_SECRET__ 占位——jwt/admin_jwt 同值，accounts.rs fail-fast 一致性）
jwt_secret: "__JWT_SECRET__"
admin_jwt_secret: "__JWT_SECRET__"
sfu:
  worker_path: /opt/mediaservo/sfu/worker

# Web 静态层（caddy）——缺省 8080 / 实例 web/；env MEDIASERVO_WEB_PORT 兜底（yaml 配置优先，C35 同形）。
# web:
#   port: 8080
#   static_root: "/abs/web"
#
# SFU/weaknet 端口 —— 缺省 20000 / 9810（env MEDIASERVO_SFU_PORT 兜底 sfu.port）。
# sfu:
#   port: 20000
#   weaknet_port: 9811
