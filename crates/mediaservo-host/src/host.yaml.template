# MediaServo host configuration (generated by host init, unified YAML format)
host:
  device_id: ""

# signaling:
#   server_url: "ws://192.168.2.127:9800/ws"   # Remote MediaServo server (default ws://127.0.0.1:9800/ws)
#   psk: "mediaservo-dev"                        # Signaling PSK (must match the server)
#   room: "my-car1"                              # Vehicle room (multi-vehicle isolation)
#   local_port: 17980                            # Local signaling gateway port

# ── defaults: shared defaults section (host-stream-defaults D282) ────────────────────────────
# Multi-source multi-stream deployments no longer copy the same encode/capture parameters per entry. Merge chain
#   **entry config > defaults.<subsection> > built-in default**
# merged per **key** per entry (writing one key on an entry does not override the whole section), merged only once
# at the parse point (translate) — the oxfile command line and capturer/streamer all see the merged values.
# Snapshot semantics: values are rendered into the oxfile; config changes require build:deploy host (or apply + oxmgr restart) to take effect.
# This section's key names are strict: a typo key / an identity key (id, source) errors out at init/start/apply time.
defaults:
  streams:
    codec: h264            # already the built-in default; may be omitted — listed to show the shape
    stream_mode: smooth    # global teleop preset; surveillance/forensic streams specialize quality per entry
    keyframe_interval: 2
  sources:
    # only platform/tuning keys may be shared (backend/width/height/fps/reconnect_ms);
    # mode/input are source identity and must be written per entry — under a global generator, a new source missing its config would silently produce color bars.
    fps: 30
# defaults.streams allowed keys = every optional key of streams[]:
#   codec / encoder_backend / bitrate_kbps / stream_mode / min_bitrate_kbps / keyframe_interval
# defaults.sources allowed keys = platform/tuning keys (identity keys mode/input excluded — writing them is rejected at deploy):
#   backend / width / height / fps / reconnect_ms

# Video source declarations (replaces the old cameras key; old "cameras:" still parses —
# #[serde(alias = "cameras")] compatibility for deployed configs, no breakage).
#
# mode has four kinds (logical categories):
#   generator   test/demo color-bar frames — the only real implementation this phase (VideoFrameGenerator produces frames; fps/width/height apply)
#   camera      real camera capture — v4l2 backend implemented (2026-08-27: mmap + YUYV/NV12→I420; tegra lacks S_PARM, degraded per PIT-145)
#   desktop     screen capture (unimplemented; capturer exits with an explicit "unsupported" error)
#   subscriber  subscribe external sources (FrameBus/ROS topic — input holds the topic; unimplemented; capturer exits with an explicit "unsupported" error)
#
# Key semantics (all optional; unset values fall through to the upper defaults / built-ins):
#   backend       capture backend declaration (v4l2 | mipi) — the current capturer auto-selects by mode+input; this key is declarative only
#   input         unified source address field: camera=device path / subscriber=FrameBus/ROS topic / desktop=display identifier (may be empty)
#   width/height  frame size (default 1280x720; subscriber may omit — frames carry their own metadata)
#   fps           frame rate (default 30; must be >0 and <=60; the smooth preset's bitrate floor derives from this value, see stream_mode)
#   reconnect_ms  camera reconnect interval ms (passed through to capturer --reconnect-ms only when mode=camera)
#
# Internal topology convention: the capturer publish topic prefix camera/<id> is reserved as-is (not migrated this phase).
# Old configs without mode -> treated as generator (the original stub generation semantics).
sources:
  - id: "cam0"
    mode: "camera"          # camera capture (v4l2 implemented)
    backend: "v4l2"         # declaration slot (not consumed by current auto-selection)
    input: "/dev/video0"    # device path
    width: 1920
    height: 1080
    fps: 30
    reconnect_ms: 5000      # camera reconnect
  - id: "test"              # minimal shape: remaining keys (mode/fps) fall through to defaults / built-ins

# Stream-publish declarations. streams[].source references sources[].id (old key "camera:" still parses —
# #[serde(alias = "camera")] compatibility). Default source = the stream id itself (topic camera/<id> direct).
#
# Encode/policy keys (may be written on an entry or in defaults.streams as shared values; same semantics):
#   codec              encoding format (default h264 — D282 revision, formerly vp8):
#                       h264  OpenH264 software encode, bandwidth-friendly, this product's primary format (browser/vehicle universal)
#                       vp8   libwebrtc built-in software encode, best compatibility, moderate CPU cost
#                       vp9   software, highest compression ratio but heavy CPU cost (avoid for 4K/high bitrate)
#                       av1   software (SVT-AV1, extremely high CPU — generally not recommended for live push)
#                     note: deployments without an explicit codec switch from vp8 to h264 after upgrade; to keep
#                       the old behavior, write codec: vp8 explicitly on the entry or in defaults.streams.
#                     invalid values (incl. case differences) error at init/start/apply time and never reach the streamer.
#   encoder_backend    encoder backend (default decided per codec, see the auto row):
#                       auto      same as unset: codec=h264 → pinned to software (PIT-156 root fix: the h264 hardware
#                                 path was never usable on this link; Jetson auto picks MMAPI →
#                                 negotiation mismatch yields a black screen); other codecs keep runtime auto-selection
#                       software  force software encoding (OpenH264/VP8 — universal platform fallback)
#                       hardware  force hardware encoding (an explicit value passes through as-is, incl. "knowingly unusable but try anyway")
#                       nvenc     NVIDIA GPU (requires a CUDA-enabled webrtc-sys build — if this repo's build log
#                                 shows "cuda.h not found", it is unavailable)
#                       vaapi     Intel/AMD GPU VA-API (Linux)
#   bitrate_kbps       encoding bitrate kbps (default 2000; for 1080p suggest 2500-4000, 720p 1500-2500)
#   stream_mode        weak-network policy preset (default balanced = send no new params, behavior identical to the old version):
#                       smooth    latency-first — hold framerate, drop resolution + Fluid hint + bitrate floor.
#                                 The floor derives from the associated source's actual fps:
#                                   min_bitrate = max(50, fps × 100 / 30) kbps
#                                   (15fps→50 / 24→80 / 30→100 / 60→200) —
#                                 constant bytes per frame, no longer a flat fixed value (recommended for teleoperation)
#                       balanced  libwebrtc balanced degradation of both (default)
#                       quality   quality-first — hold resolution, drop framerate + 3000kbps ceiling (recommended for forensics)
#                     every preset may be overridden by explicit keys: bitrate_kbps / min_bitrate_kbps — written means your value wins
#                     (entry > defaults.streams > preset bundle); an over-high min_bitrate_kbps
#                     artificially inflates bitrate and hurts latency — suggested: <= bitrate_kbps/4.
#   min_bitrate_kbps   bitrate floor kbps (explicit override slot; default: smooth uses the fps-derived formula above)
#   keyframe_interval  keyframe interval seconds (GOP, default 2; smaller = faster packet-loss recovery, less stable bitrate)
#
# Reference (specialized shape — write only the keys differing from defaults; the rest inherit):
#   - id: "cam1-stream"
#     source: "cam1"
#     stream_mode: "quality"     # surveillance/forensics: hold resolution, drop framerate + 3000kbps ceiling
#     bitrate_kbps: 3500
streams:
  - id: "cam0-stream"
    source: "cam0"          # references sources[].id (minimal shape: encode/policy keys from defaults)

record:
  enabled: false

control:
  enabled: false
