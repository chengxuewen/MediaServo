# MediaServo host 配置（host init 生成，统一 YAML 格式）
host:
  device_id: ""

# signaling:
#   server_url: "ws://192.168.2.127:9800/ws"   # 远程 MediaServo server（缺省 ws://127.0.0.1:9800/ws）
#   psk: "mediaservo-dev"                        # 信令 PSK（须与 server 一致）
#   room: "my-car1"                              # 整车房间（多车隔离）
#   local_port: 17980                            # 本地信令网关端口

# 视频源声明（替代旧 cameras 键；旧 "cameras:" 仍可解析——`#[serde(alias = "cameras")]`
# 兼容已部署配置，无破坏）。
#
# mode 四类（逻辑类别）：
#   generator   测试/演示彩条帧——本期唯一真实实现（VideoFrameGenerator 产帧，fps/width/height 生效）
#   camera      真实相机采集——backend=v4l2（已实现 2026-08-27：v4l crate mmap + YUYV/NV12→I420；tegra 无 S_PARM 降级 PIT-145）
#   desktop     屏幕捕获（未实现；capturer 明确报"未支持"退出）
#   subscriber  订阅外部源（FrameBus/ROS topic（input 填 topic）；未实现；capturer 明确报"未支持"退出）
#
# 字段语义：
#   backend      采集后端，仅 mode=camera 生效（v4l2 | mipi，单词字段）
#   input        源地址统一字段：camera=设备路径 / subscriber=FrameBus/ROS topic / desktop=显示标识（可空）
#   width/height 帧宽高（缺省 1280x720；subscriber 可省略——帧自带元数据）
#   fps          帧率（缺省 30；须 > 0）
#   reconnect_ms 相机重连间隔 ms（预留；本期未消费）
#
# 内部拓扑约定：capturer 发布 topic 前缀 `camera/<id>` 保留不动（本期不迁）。
# 旧配置无 mode -> 按 generator 处理（原 stub 语义）。
sources:
  - id: "cam0"
    mode: "camera"          # 相机（backend 采集后端实现中——当前 capturer 报未支持）
    backend: "v4l2"         # v4l2 | mipi（仅 mode=camera 生效）
    input: "/dev/video0"    # 设备路径
    width: 1920
    height: 1080
    fps: 30
    reconnect_ms: 5000      # 相机重连（预留）
  - id: "test"
    mode: "generator"       # 彩条生成器（真实产帧；链路验证用）
    fps: 30

# 推流声明。streams[].source 引用 sources[].id（旧键名 "camera:" 仍可解析——
# `#[serde(alias = "camera")]` 兼容）。缺省 source = 流 id 自身（topic camera/<id> 直连）。
#
# 可用字段（全部可选，缺省即默认）：
#   codec              编码格式（缺省 vp8）：
#                       vp8   libwebrtc 内置软编，兼容性最好，CPU 开销中等
#                       h264  OpenH264 软编（构建无 CUDA 时也回退软编），带宽友好
#                       vp9  软件，压缩率最高但 CPU 开销大（4K/高码率慎用）
#                       av1  软件（SVT-AV1，CPU 极高——通常不建议实时推流）
#   encoder_backend    编码器后端（缺省 auto 运行时选择）：
#                       auto      自动（默认——优先硬件，不可用回退软件）
#                       software  强制软件编码（OpenH264/VP8——通用平台兜底）
#                       hardware  强制硬件编码（Jetson tegra 推荐——NvCodec 路径）
#                       nvenc     NVIDIA GPU（需带 CUDA 构建 webrtc-sys——本仓库构建
#                                 日志出现 "cuda.h not found" 即不可用，回退 auto/software）
#                       vaapi     Intel/AMD GPU VA-API（Linux）
#   bitrate_kbps       编码码率 kbps（缺省 2000；1080p 建议 2500-4000，720p 1500-2500）
#   stream_mode        弱网策略档（缺省 balanced=行为与旧版一致）：
#                       smooth    实时优先——保帧率降分辨率 + Fluid hint + 400kbps 码率地板
#                                 （遥控/遥操作推荐；弱网下帧率钉住，画质让位）
#                       balanced  libwebrtc 均衡双降（缺省，不发任何新参数）
#                       quality   画质优先——保分辨率降帧率 + 3000kbps 天花板（取证推荐）
#                     数值为预设 bundle，可被显式键覆盖：bitrate_kbps / min_bitrate_kbps
#                     写了就以你写的为准（显式 > preset）；min_bitrate_kbps 设过高会人为
#                     抬码率伤时延，建议 ≤ bitrate_kbps/4。
#                     快照语义：stream_mode/码率键编译进 oxfile 命令行，改配置后需
#                     build:deploy host（或 apply 后 oxmgr restart）重渲染才生效。
#   min_bitrate_kbps   码率地板 kbps（可选显式覆盖位；缺省随 stream_mode 预设）
#   keyframe_interval  关键帧间隔秒（GOP，缺省 2；越小丢包恢复越快、码率越不稳定）
#
# 参考示例（完整字段）：
#   - id: "cam0-stream"
#     source: "cam0"
#     codec: "h264"
#     encoder_backend: "hardware"     # Jetson 车端硬编
#     bitrate_kbps: 3500
#     keyframe_interval: 2
streams:
  - id: "cam0-stream"
    source: "cam0"          # 引用 sources[].id
    codec: "h264"           # 编码格式（缺省 vp8；可选 vp8/h264/vp9/av1——见上注释）

record:
  enabled: false

control:
  enabled: false