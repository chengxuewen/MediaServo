# Secrets (D208: 防密钥类文件入镜像)
.env*
*.key
config/*.local*

# host 运行实例（socket/日志/状态——构建 context 污染）
.host/
install/
dist/

# container-build-rework B3.3 (tree-packaged prod image): the live instance
# tree carries real credentials + runtime state (never a build input — the
# image assembles a FRESH --prefix staging); build/ holds cmake deploy trees;
# node_modules is platform-specific and reinstalled by pnpm in-image.
out/
build/
.cache/
**/node_modules/
www/apps/admin/dist/
www/apps/voice/dist/
