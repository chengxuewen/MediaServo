# This file is used to ignore files which are generated
# ----------------------------------------------------------------------------

*~
*.autosave
*.core
*.orig
*.rej
.#*
*.*#
tags
.DS_Store
.directory
*.debug
*.app
Thumbs.db

# xemacs temporary files
*.flc

# Vim temporary files
.*.swp

# Visual Studio generated files
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*

# MinGW generated files
*.Debug
*.Release

# Python byte code
*.pyc

# Binaries
# --------
*.dll
*.exe

# IDE files
# --------
.vs
.idea
.cache
.vscode/*
# whitelist: only the IDE settings template is tracked (polyorch-adoption CA-1;
# a negation under a plain `.vscode` dir-rule is inert — git never descends)
!.vscode/settings.example.json

# Build dirs
# --------
out
log
dist
build
target
*.node
/install

# Temp dirs
# --------
nodejs
stash

# nodejs environments
node_modules
.npm-cache
.turbo

# agent toolchain local echoes (pins live in scripts/agents/mcp-servers.json)
scripts/agents/package.json
scripts/agents/package-lock.json
__pycache__/
*.pyc

# Don't ignore files
# --------
!.vscode/settings.json
!.omo/omo.jsonc

# Agent dirs
.venv-openspace
.playwright-mcp
.codegraph
# pixi environment manager
.pixi
.pixi-pack
.pixi-cache
.sisyphus/
.omo/*

# Official reference source clones (git-ignored, script-managed)
.refinfo

# Test and build artifacts
test-results
*.tsbuildinfo

# Python bindings example artifacts
bindings/python/mediaservo/examples/recorded.mp4/bindings/python/mediaservo/mediaservo/_libs/
/bindings/python/mediaservo/mediaservo.egg-info/

# host multi-process runtime artifacts (host init/start at repo root)
.host/
/etc/
/run/
/recordings/
/identity.json
data/

# imgui 布局缓存（09-24 脱轨：曾被子仓根跟踪=CI/构建目录污染面）
imgui.ini
*.imgui.ini
imgui_viewer.ini
